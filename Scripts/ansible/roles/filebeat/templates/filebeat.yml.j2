filebeat.inputs:
  - type: journald
    id: system-journal

output.logstash:
  hosts: ["{{ logstash_host }}:{{ logstash_port }}"]

# Tags each event with the inventory group this host belongs to
# (firewalls, dns, ipa, ...) so it's easy to filter in Kibana.
fields:
  lab_role: "{{ group_names | difference(['monitored']) | first | default('unknown') }}"
fields_under_root: true

logging.level: info
logging.to_files: true
logging.files:
  path: /var/log/filebeat
  name: filebeat
  keepfiles: 7
